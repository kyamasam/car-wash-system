# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ENVIRONMENT=production
PROJECT_NAME=Samfast Car Wash
PROJECT_DESCRIPTION=Car wash management system

# PostgreSQL
PG_NAME=samfast_carwash
PG_USER=postgres
PG_PASSWORD=changeme
# PG_HOST and PG_PORT are set automatically by docker-compose

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=your@email.com

# CORS / Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

# Frontend URL (used in backend email links)
FRONT_END_LINK=http://localhost

# Next.js
NEXT_PUBLIC_API_URL=http://localhost/api

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Gemini AI
GEMINI_API_KEY=
AI_VERSION=gemini-pro

# M-Pesa
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Encryption
FIELD_ENCRYPTION_KEY=

# Celery queue name
CELERY_TASK_DEFAULT_QUEUE=sf_networks
